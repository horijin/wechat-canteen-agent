.profile { display: flex; align-items: center; padding: 28rpx; }
.avatar { flex: 0 0 84rpx; width: 84rpx; height: 84rpx; margin-right: 20rpx; border-radius: 24rpx; color: #fff; background: linear-gradient(135deg, #176b52, #3f9275); font-size: 36rpx; font-weight: 800; line-height: 84rpx; text-align: center; }
.profile-copy { flex: 1; min-width: 0; }
.stall-name { overflow: hidden; font-size: 33rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.canteen-name { margin-top: 8rpx; color: #7b8782; font-size: 23rpx; }
.business-state { padding: 8rpx 14rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 700; }
.business-state.open { color: #176b52; background: #e5f3ed; }
.business-state.closed { color: #a53a29; background: #ffede9; }
.setting-card { padding: 26rpx; }
.label { color: #34423c; font-weight: 700; }
.description { margin-top: 8rpx; color: #89948f; font-size: 23rpx; line-height: 1.5; }
.api-input { height: 80rpx; margin-top: 16rpx; padding: 0 18rpx; border: 1rpx solid #dce4e0; border-radius: 14rpx; background: #f8faf9; font-size: 25rpx; }
.connection-row { margin-top: 18rpx; }
.connection { display: flex; align-items: center; max-width: 330rpx; color: #7b8782; font-size: 22rpx; }
.connection .dot { flex: 0 0 14rpx; width: 14rpx; height: 14rpx; margin-right: 9rpx; border-radius: 50%; background: #aab2ae; }
.connection.online { color: #176b52; }
.connection.online .dot { background: #3cb77c; }
.connection.offline { color: #b13f2d; }
.connection.offline .dot { background: #d75e49; }
.connection.testing .dot { background: #d8922a; }
.small-button { display: inline-flex; margin: 0 0 0 10rpx; }
.setting-row { display: flex; align-items: center; justify-content: space-between; }
.checklist { display: flex; align-items: center; }
.check-icon { flex: 0 0 58rpx; width: 58rpx; height: 58rpx; margin-right: 18rpx; border-radius: 17rpx; color: #aa6117; background: #fff0dc; font-size: 32rpx; font-weight: 800; line-height: 58rpx; text-align: center; }
.check-copy { flex: 1; }
.chevron { color: #98a29d; font-size: 44rpx; }
.switch-button { margin-top: 44rpx; }
.version { margin-top: 30rpx; color: #a0a8a4; font-size: 21rpx; text-align: center; }
