.orders-page { min-height: 100vh; }
.filter-panel { position: sticky; top: 0; z-index: 4; padding: 22rpx 24rpx 0; border-bottom: 1rpx solid #e7ece9; background: rgba(255,255,255,.97); }
.date-row { display: flex; align-items: center; justify-content: space-between; }
.title { font-size: 36rpx; font-weight: 800; }
.subtitle { margin-top: 6rpx; color: #7b8782; font-size: 22rpx; }
.date-picker { padding: 15rpx 20rpx; border-radius: 14rpx; color: #176b52; background: #edf6f2; font-size: 24rpx; font-weight: 600; }
.filters { width: 100%; margin-top: 18rpx; white-space: nowrap; }
.filter-line { display: inline-flex; gap: 12rpx; padding-bottom: 18rpx; }
.filter { padding: 14rpx 19rpx; border-radius: 999rpx; color: #64716b; background: #f1f4f2; font-size: 24rpx; }
.filter.active { color: #fff; background: #176b52; }
.count { margin-left: 8rpx; opacity: .78; }
.content { padding: 22rpx 24rpx; }
.loading { padding: 100rpx 0; color: #7b8782; text-align: center; }
.error-card { margin-bottom: 20rpx; padding: 20rpx; border-radius: 16rpx; color: #a44128; background: #fff1ed; text-align: center; }
