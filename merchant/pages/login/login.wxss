.login-page { min-height: 100vh; padding: 70rpx 34rpx 40rpx; background: linear-gradient(155deg, #e8f4ee 0%, #f7f8f5 42%, #f4f7f5 100%); }
.brand { display: flex; align-items: center; max-width: 660rpx; margin: 0 auto 48rpx; }
.brand-mark { width: 84rpx; height: 84rpx; margin-right: 22rpx; border-radius: 26rpx; color: #fff; background: #176b52; font-size: 40rpx; font-weight: 800; text-align: center; line-height: 84rpx; box-shadow: 0 12rpx 30rpx rgba(23,107,82,.22); }
.brand-title { font-size: 38rpx; font-weight: 800; }
.brand-subtitle { margin-top: 7rpx; color: #6f7d77; font-size: 25rpx; }
.panel { max-width: 660rpx; margin: 0 auto; padding: 38rpx 32rpx; }
.eyebrow { color: #176b52; font-size: 23rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { margin-top: 12rpx; font-size: 40rpx; font-weight: 800; }
.hint { margin: 14rpx 0 34rpx; color: #76837d; font-size: 24rpx; line-height: 1.65; }
.field-label { margin: 24rpx 0 12rpx; color: #4f5d57; font-weight: 650; }
.picker-field { display: flex; justify-content: space-between; align-items: center; min-height: 88rpx; padding: 0 24rpx; border: 2rpx solid #dfe7e3; border-radius: 16rpx; background: #fbfcfb; }
.arrow { color: #86938d; font-size: 44rpx; }
.stall-list { display: flex; flex-direction: column; gap: 14rpx; }
.stall { display: flex; align-items: center; justify-content: space-between; padding: 22rpx; border: 2rpx solid #e1e7e4; border-radius: 18rpx; }
.stall.selected { border-color: #176b52; background: #f0f8f5; }
.stall-name { font-weight: 700; }
.stall-meta { margin-top: 8rpx; color: #7b8782; font-size: 23rpx; }
.radio { width: 40rpx; height: 40rpx; border: 2rpx solid #b8c4bf; border-radius: 50%; color: #fff; background: #fff; text-align: center; line-height: 36rpx; }
.selected .radio { border-color: #176b52; background: #176b52; }
.loading { padding: 38rpx 0; color: #7b8782; text-align: center; }
.error-box { padding: 22rpx; border-radius: 16rpx; color: #a44128; background: #fff2ed; line-height: 1.5; }
.retry { margin-top: 14rpx; }
.enter { margin-top: 36rpx; height: 92rpx; line-height: 92rpx; }
.server-link { padding: 24rpx 0 4rpx; color: #6b7772; font-size: 24rpx; text-align: center; }
.server-box { margin-top: 20rpx; padding: 20rpx; border-radius: 16rpx; background: #f1f5f3; }
.server-input { height: 76rpx; margin-bottom: 16rpx; padding: 0 18rpx; border: 1rpx solid #d7e1dc; border-radius: 12rpx; background: #fff; font-size: 25rpx; }
.version { margin-top: 36rpx; color: #9aa49f; font-size: 22rpx; text-align: center; }
