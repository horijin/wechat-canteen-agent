page {
  height: 100%;
  background-color: #f7f9f8;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  position: relative;
}

/* 顶部栏与左上角购物车入口 */
.ai-header-bar {
  position: sticky;
  top: 0;
  background: #ffffff;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #edf0ee;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.cart-btn-box {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  background: #e5f2ed;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cart-icon {
  font-size: 32rpx;
}

.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: #e53e3e;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.header-tips {
  font-size: 24rpx;
  color: #55605a;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

/* 消息列表 */
.message-list {
  flex: 1;
  height: 0;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
  gap: 16rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.ai-avatar {
  background: linear-gradient(135deg, #4285f4, #9b51e0, #ea4335);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(66, 133, 244, 0.2);
}

/* 消息气泡 */
.msg-bubble {
  max-width: 80%;
  padding: 20rpx 26rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.msg-bubble.ai {
  background: #ffffff;
  color: #1f2937;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.msg-bubble.user {
  background: #176b52;
  color: #ffffff;
  border-top-right-radius: 4rpx;
}

/* 推荐多菜品外容器 */
.dishes-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.recommend-card-item {
  display: flex;
  flex-direction: column;
}

/* 菜品推荐卡片 */
.dish-card {
  padding: 16rpx;
  background: #f4f7f5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-info {
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-weight: 700;
  font-size: 26rpx;
  color: #111827;
}

.dish-price {
  color: #dc5a37;
  font-weight: 700;
  font-size: 26rpx;
  margin-top: 4rpx;
}

.add-btn {
  font-size: 22rpx;
  color: #ffffff;
  background: #176b52;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

/* 营养数据卡片 */
.nutrition-card {
  margin-top: 10rpx;
  padding: 16rpx 20rpx;
  background: #eef6f3;
  border: 1rpx solid #d1e6de;
  border-radius: 16rpx;
}

.nutrition-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.nut-icon {
  font-size: 24rpx;
}

.nut-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #176b52;
}

.nutrition-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  text-align: center;
}

.nut-item {
  background: #ffffff;
  padding: 8rpx 4rpx;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nut-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #111827;
}

.nut-lbl {
  font-size: 18rpx;
  color: #6b7280;
  margin-top: 2rpx;
}

/* 预设 Prompt */
.preset-hints {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 28rpx 20rpx;
}

.hint-tag {
  background: #ffffff;
  border: 1rpx solid #d5dbd8;
  color: #374151;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

/* 底部输入栏 */
.input-bar {
  background: #ffffff;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-top: 1rpx solid #edf0ee;
  z-index: 10;
}

.chat-input {
  flex: 1;
  background: #f2f5f3;
  height: 72rpx;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx !important;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  font-size: 26rpx;
  border-radius: 36rpx;
  background: #d5dbd8 !important;
  color: #ffffff !important;
  font-weight: 600;
  transition: all 0.2s ease;
}

.send-btn.active {
  background: #176b52 !important;
}

/* 购物车弹出抽屉 */
.drawer-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 190;
}

.cart-drawer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  z-index: 200;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.cart-drawer.show {
  transform: translateY(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
}

.clear-btn {
  font-size: 24rpx;
  color: #7b8782;
}

.drawer-list {
  max-height: 400rpx;
}

.drawer-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f5f3;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
}

.item-price {
  width: 120rpx;
  color: #dc5a37;
  font-weight: 700;
}

.item-counter {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 居中加减号按钮 */
.cnt-btn {
  width: 48rpx !important;
  height: 48rpx !important;
  padding: 0 !important;
  line-height: 44rpx !important;
  border-radius: 50% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx !important;
  font-weight: bold;
  background: #f0f2f1 !important;
  color: #55605a !important;
  border: 1rpx solid #d5dbd8 !important;
}

.cnt-btn.plus {
  background: #176b52 !important;
  color: #ffffff !important;
  border: none !important;
}

.cnt-num {
  font-size: 28rpx;
  font-weight: 600;
  min-width: 32rpx;
  text-align: center;
}

.empty-cart-tips {
  text-align: center;
  padding: 60rpx 0;
  color: #9ca3af;
  font-size: 26rpx;
}

.drawer-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf0ee;
}

.total-price {
  color: #dc5a37;
  font-size: 36rpx;
  font-weight: 700;
}

.checkout-btn {
  background: #176b52 !important;
  color: #ffffff !important;
  border-radius: 36rpx;
  font-size: 28rpx;
  padding: 12rpx 36rpx;
}

/* 思考中动效 */
.thinking-bubble {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  padding: 20rpx 28rpx;
}

.thinking-text {
  font-size: 26rpx;
  color: #6b7280;
}

.dots-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  background-color: #176b52;
  border-radius: 50%;
  animation: dotFlashing 1.2s infinite ease-in-out;
}

.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotFlashing {
  0%, 80%, 100% {
    opacity: 0.3;
    transform: scale(0.8);
  }
  40% {
    opacity: 1;
    transform: scale(1.3);
  }
}